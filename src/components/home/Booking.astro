---
import SectionHead from '@/components/SectionHead.astro';
import CopyEmail from '@/components/CopyEmail.astro';
import Icon from '@/components/Icon.astro';
import { site, linkedin, catalog } from '@/data/site';
---

<section id="contact" class="section booking" aria-labelledby="contact-title">
  <div class="container">
    <SectionHead id="contact-title" track="B4" label="Contact" title="Booking" meta="& A&R">
      <p>{site.contact.blurb}</p>
    </SectionHead>

    <div class="ticket">
      <div class="tk-main">
        <p class="wide tk-presents">{site.label.name} presents</p>
        <p class="display tk-title">An interview with {site.name}</p>

        <dl class="tk-details">
          <div>
            <dt class="wide">Booking</dt>
            <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
          </div>
          <div>
            <dt class="wide">Venue</dt>
            <dd>{site.location.display}, or a video call</dd>
          </div>
          {
            site.availability && (
              <div class="tk-wide">
                <dt class="wide">Seeking</dt>
                <dd>{site.availability.split(' · ')[0]}</dd>
              </div>
            )
          }
        </dl>
      </div>

      <div class="tk-stub" aria-hidden="true">
        <p class="wide">Admit one</p>
        <p class="display tk-cat">{catalog(1)}</p>
        <span class="barcode"></span>
        <p class="mono tk-no">No. 000001</p>
      </div>
    </div>

    <div class="tk-actions">
      <a class="btn" href={`mailto:${site.contact.email}`}><Icon name="mail" /> Email Gwido</a>
      <span class="tk-links">
        <CopyEmail email={site.contact.email} class="link-arrow tk-link" />
        {
          linkedin && (
            <a class="link-arrow tk-link" href={linkedin.href} rel="me noopener" target="_blank">
              <Icon name="linkedin" /> LinkedIn
            </a>
          )
        }
        <a class="link-arrow tk-link" href={site.resume.href}>
          <Icon name="printer" /> Résumé
        </a>
      </span>
    </div>
  </div>
</section>

<style>
  .ticket {
    position: relative;
    display: grid;
    max-width: 62rem;
    background: var(--red);
    color: #16130f;
    border-radius: 6px;
    filter: drop-shadow(0 20px 30px rgb(40 15 5 / 0.25));
  }

  /* Punched notches where the perforation meets the edges. */
  @media (min-width: 46rem) {
    .ticket {
      grid-template-columns: minmax(0, 1fr) 13rem;
      -webkit-mask:
        radial-gradient(circle 0.9rem at calc(100% - 13rem) 0, transparent 98%, #000) top / 100% 51% no-repeat,
        radial-gradient(circle 0.9rem at calc(100% - 13rem) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
      mask:
        radial-gradient(circle 0.9rem at calc(100% - 13rem) 0, transparent 98%, #000) top / 100% 51% no-repeat,
        radial-gradient(circle 0.9rem at calc(100% - 13rem) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat;
    }
  }

  .tk-main {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }

  .tk-presents {
    font-size: 0.7rem;
  }

  .tk-title {
    max-width: 16ch;
    font-size: clamp(2.3rem, 1.4rem + 3.4vw, 4.2rem);
    line-height: 0.86;
  }

  .tk-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem 2rem;
    margin: 1rem 0 0;
    padding-top: 1.1rem;
    border-top: 1.5px solid #16130f;
  }

  .tk-wide {
    grid-column: 1 / -1;
  }

  .tk-details dt {
    font-size: 0.6rem;
    opacity: 0.75;
  }

  .tk-details dd {
    margin: 0.25rem 0 0;
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .tk-details a {
    text-decoration-thickness: 1.5px;
  }

  .tk-details a:hover {
    color: #fff;
  }

  .tk-stub {
    display: none;
  }

  @media (min-width: 46rem) {
    .tk-stub {
      display: grid;
      align-content: space-between;
      justify-items: center;
      gap: 1rem;
      padding: 2rem 1.25rem;
      border-left: 2px dashed rgb(22 19 15 / 0.55);
      text-align: center;
    }
  }

  .tk-cat {
    font-size: 3.4rem;
    line-height: 0.85;
  }

  .barcode {
    width: 100%;
    height: 3.6rem;
    background: repeating-linear-gradient(90deg, #16130f 0 2px, transparent 2px 4px, #16130f 4px 5px, transparent 5px 8px, #16130f 8px 11px, transparent 11px 12px, #16130f 12px 13px, transparent 13px 16px);
  }

  .tk-no {
    font-size: 0.72rem;
  }

  /* At the counter: one clear button, the rest as quiet links. */
  .tk-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .tk-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .tk-links :global(.tk-link) {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .tk-links :global(.tk-link:hover) {
    color: var(--red-ink);
  }
</style>
