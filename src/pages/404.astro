---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Record from '@/components/Record.astro';
---

<Base title="Track not found" noindex>
  <section class="container nf">
    <div class="nf-art">
      <Record class="nf-record" uid="nf" ring="Ropas Records · Side 404 · Skipping · " center="404" sub="Skip" />
    </div>
    <div class="nf-copy">
      <p class="mono">Side 404 · Track not found</p>
      <h1 class="display">The needle skipped.</h1>
      <p class="serif nf-lede">That track isn’t on this record. The link may be old, or the page may have moved.</p>
      <div class="actions">
        <a class="btn" href="/">Back to side A <Icon name="arrow-right" /></a>
        <a class="btn btn-ghost" href="/#work">Browse the releases</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 2rem + 6vw, 8rem);
  }

  @media (min-width: 52rem) {
    .nf {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .nf-art {
    max-width: 26rem;
  }

  /* A record that skips: a twitch every couple of seconds instead of a smooth spin. */
  .nf-art :global(.disc.loop) {
    animation: skip 2.4s steps(1) infinite;
  }

  @keyframes skip {
    0% {
      transform: rotate(0deg);
    }
    40% {
      transform: rotate(12deg);
    }
    44% {
      transform: rotate(-4deg);
    }
    80% {
      transform: rotate(8deg);
    }
  }

  .nf-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .nf-copy .mono {
    color: var(--red-ink);
  }

  h1 {
    font-size: var(--step-6);
  }

  .nf-lede {
    max-width: 26ch;
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
