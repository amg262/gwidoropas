---
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { canonicalUrl } from '@/lib/work';
import '@/styles/global.css';

interface Props {
  /** Page title. Omit on the home page to use the site title. */
  title?: string;
  description?: string;
  /** Path of the Open Graph image, relative to the site root. */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og/home.png',
  ogType = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = canonicalUrl(Astro.url, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const sameAs = site.social.map((s) => s.href);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  email: `mailto:${site.contact.email}`,
  jobTitle: 'Marketing Student',
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.education.school },
  knowsAbout: site.skills.flatMap((g) => g.items).slice(0, 12),
  sameAs,
};

const structuredData = [personLd, ...jsonLd];
const ga4 = site.analytics.ga4;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#f6f2ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13110e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / LinkedIn / iMessage / Slack previews -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.title} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-body" preload={[{ style: 'normal', subset: 'latin' }]} />

    {structuredData.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      ga4 && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      site.isTemplate && (
        <aside class="template-banner" aria-label="Template notice">
          <strong>Template content.</strong> The name, projects and numbers on this site are placeholders. Edit{' '}
          <code>src/data/site.ts</code> and <code>src/content/work/</code> to make it yours.
        </aside>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {site.analytics.vercel && <Analytics />}
  </body>
</html>

<style>
  .template-banner {
    padding: 0.55rem var(--gutter);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--step--1);
    text-align: center;
    line-height: 1.4;
  }

  .template-banner code {
    font-size: 0.95em;
    padding: 0.05em 0.35em;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.14);
  }

  @media (prefers-color-scheme: dark) {
    .template-banner code {
      background: rgb(0 0 0 / 0.12);
    }
  }
</style>
