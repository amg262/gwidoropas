---
/**
 * A one-page résumé generated from src/data/site.ts and the case studies,
 * so the site and the résumé never drift apart. Visitors can print it or
 * "Save as PDF" — the print stylesheet strips the site chrome.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import { getWork } from '@/lib/work';

const work = (await getWork()).slice(0, 3);
const host = Astro.site ? Astro.site.host : '';
---

<Base title="Résumé" description={`Résumé of ${site.name}: ${site.education.degree}, ${site.education.school}.`}>
  <div class="container toolbar">
    <a class="link-arrow" href="/"><Icon name="arrow-left" /> Back to portfolio</a>
    <button class="btn" type="button" data-print><Icon name="printer" /> Print / Save as PDF</button>
  </div>

  <article class="container sheet" aria-label={`Résumé of ${site.name}`}>
    <header class="r-head">
      <div>
        <h1>{site.name}</h1>
        <p class="r-sub">{site.education.degree}, {site.education.school} · {site.education.graduation}</p>
      </div>
      <ul class="r-contact">
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        {host && <li><a href="/">{host}</a></li>}
        {site.social.filter((s) => s.label === 'LinkedIn').map((s) => <li><a href={s.href}>{s.href.replace(/^https?:\/\/(www\.)?/, '')}</a></li>)}
        <li>{site.contact.location}</li>
      </ul>
    </header>

    <section>
      <h2>Profile</h2>
      <p>{site.hero.intro}</p>
    </section>

    <section>
      <h2>Experience</h2>
      {
        site.experience.map((job) => (
          <div class="r-item">
            <div class="r-row">
              <h3>
                {job.role}, <span>{job.org}</span>
              </h3>
              <p class="r-date">
                {job.start} – {job.end}
              </p>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Selected projects</h2>
      {
        work.map((w) => (
          <div class="r-item">
            <div class="r-row">
              <h3>
                {w.data.title} <span>· {w.data.context}</span>
              </h3>
            </div>
            <p>
              {w.data.summary}
            </p>
            <p class="r-metrics">
              {w.data.metrics.map((m, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <strong>{m.value}</strong> {m.label}
                </>
              ))}
            </p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Education</h2>
      <div class="r-item">
        <div class="r-row">
          <h3>
            {site.education.school}, <span>{site.education.degree}</span>
          </h3>
          <p class="r-date">{site.education.graduation}</p>
        </div>
        <ul>
          {site.education.details.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </section>

    <section class="r-split">
      <div>
        <h2>Skills</h2>
        <dl>
          {
            site.skills.map((g) => (
              <div>
                <dt>{g.group}:</dt> <dd>{g.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h2>Certifications</h2>
        <ul class="plain">
          {
            site.certifications.map((c) => (
              <li>
                {c.name}, {c.issuer} ({c.year})
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 1.5rem;
  }

  .toolbar :global(svg) {
    width: 1.05em;
    height: 1.05em;
  }

  .sheet {
    max-width: 52rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .r-head {
    display: grid;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--ink);
  }

  @media (min-width: 40rem) {
    .r-head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .r-sub {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }

  .r-contact {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.92em;
    color: var(--ink-2);
  }

  @media (min-width: 40rem) {
    .r-contact {
      text-align: right;
    }
  }

  .r-contact a {
    text-decoration: none;
  }

  section {
    padding-top: 1.4em;
  }

  h2 {
    margin-bottom: 0.7em;
    font-family: var(--font-body);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .r-item + .r-item {
    margin-top: 0.9em;
  }

  .r-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
  }

  h3 {
    font-family: var(--font-body);
    font-size: 1.03em;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  h3 span {
    font-weight: 400;
    color: var(--ink-2);
  }

  .r-date {
    color: var(--muted);
    font-size: 0.92em;
    font-variant-numeric: tabular-nums;
  }

  .r-item ul {
    margin: 0.3rem 0 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
  }

  .r-item p {
    color: var(--ink-2);
  }

  .r-metrics {
    margin-top: 0.15rem;
    font-size: 0.9em;
  }

  .r-item strong {
    color: var(--ink);
    font-weight: 600;
  }

  .r-split {
    display: grid;
    gap: 0 2.5em;
  }

  @media (min-width: 40rem) {
    .r-split {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  dl {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }

  dt {
    display: inline;
    font-weight: 600;
  }

  dd {
    display: inline;
    margin: 0;
    color: var(--ink-2);
  }

  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .plain li + li {
    margin-top: 0.3rem;
  }

  @media print {
    @page {
      size: letter;
      margin: 0.55in 0.6in;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    :global(.template-banner),
    .toolbar {
      display: none !important;
    }

    .sheet {
      max-width: none;
      width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
      font-size: 9.5pt;
      line-height: 1.42;
      --ink: #000;
      --ink-2: #222;
      --muted: #444;
      --accent-ink: #000;
    }

    h1 {
      font-size: 24pt;
    }

    section {
      padding-top: 1.1em;
    }

    .r-head {
      grid-template-columns: 1fr auto;
    }

    .r-contact {
      text-align: right;
    }

    .r-split {
      grid-template-columns: 1.4fr 1fr;
    }

    section,
    .r-item {
      break-inside: avoid;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
