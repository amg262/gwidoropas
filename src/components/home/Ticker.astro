---
/**
 * "Now playing": a marquee of what's current. Derived, not typed: any role
 * marked nowPlaying with no end date, any credential still in the pressing
 * plant, and the availability line. Pausing the turntable stops it and lays
 * everything out statically.
 */
import { site } from '@/data/site';

const items = [
  ...site.experience.filter((e) => e.nowPlaying && e.end === null).map((e) => ({ k: e.role.split(',')[0]!, v: e.org })),
  ...site.education.credentials.filter((c) => c.status === 'pressing').map((c) => ({ k: c.credential, v: `${c.school.replace(/ \(.*\)/, '')}, ${c.date?.toLowerCase()}` })),
  ...(site.availabilityShort ? [{ k: 'Now booking', v: site.availabilityShort }] : []),
];
---

<section class="ticker" aria-label="Now playing">
  <p class="visually-hidden">Now playing: {items.map((it) => `${it.k}, ${it.v}`).join('; ')}.</p>
  <div class="tk-track loop" aria-hidden="true">
    {
      [0, 1].map((copy) => (
        <div class="tk-run" data-copy={copy}>
          <span class="tk-badge wide">
            <span class="eq">
              <i />
              <i />
              <i />
            </span>
            Now playing
          </span>
          {items.map((it) => (
            <span class="tk-item">
              <span class="tk-k">{it.k}</span>
              <span class="serif tk-v">{it.v}</span>
              <span class="tk-star">✦</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .ticker {
    overflow: hidden;
    background: var(--mustard);
    color: #16130f;
    border-block: 1.5px solid #16130f;
  }

  .tk-track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
  }

  .tk-run {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0.95rem 1rem;
    padding-right: 2rem;
    white-space: nowrap;
  }

  .tk-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: #16130f;
    color: var(--mustard);
    font-size: 0.68rem;
  }

  .tk-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7rem;
  }

  .tk-k {
    font-stretch: 62%;
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .tk-v {
    font-size: 1.3rem;
    line-height: 1;
  }

  .tk-star {
    margin-left: 1.3rem;
    font-size: 0.9rem;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Paused (or reduced motion): stop scrolling and lay it all out. */
  :global(html[data-motion='paused']) .tk-track {
    width: auto;
    animation: none;
  }

  :global(html[data-motion='paused']) .tk-run {
    flex-wrap: wrap;
    white-space: normal;
    row-gap: 0.6rem;
  }

  :global(html[data-motion='paused']) .tk-run[data-copy='1'] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html:not([data-motion='playing'])) .tk-track {
      width: auto;
      animation: none;
    }
    :global(html:not([data-motion='playing'])) .tk-run {
      flex-wrap: wrap;
      white-space: normal;
    }
    :global(html:not([data-motion='playing'])) .tk-run[data-copy='1'] {
      display: none;
    }
  }
</style>
