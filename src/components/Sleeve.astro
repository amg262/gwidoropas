---
/**
 * An album sleeve: generated cover art (or a real image) with the label's
 * typography laid over it. Type is sized in container units, so a sleeve
 * looks right at any size, from a card to a full-bleed hero.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Obi from './Obi.astro';
import { coverSvg, type CoverSpec } from '@/lib/cover';
import { site } from '@/data/site';

interface Props {
  spec: CoverSpec;
  album: string;
  catalog: string;
  /** Status sticker, e.g. "Now recording". */
  sticker?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  eager?: boolean;
  /** Wrap it in an obi strip: the paper band with the title in vertical type. */
  obi?: { title: string; sub?: string; foot?: string };
  class?: string;
}

const { spec, album, catalog, sticker, image, imageAlt = '', eager = false, obi, class: className } = Astro.props;
const svg = image ? '' : coverSvg(spec);
---

<div class:list={['sleeve', { 'has-obi': obi }, className]} style={`--s-bg:${spec.bg};--s-fg:${spec.fg};--s-accent:${spec.accent}`}>
  {
    image ? (
      <Image src={image} alt={imageAlt} widths={[400, 800, 1200]} sizes="(min-width: 60rem) 40vw, 90vw" loading={eager ? 'eager' : 'lazy'} class="art" />
    ) : (
      <div class="art" set:html={svg} />
    )
  }
  <div class="s-top" aria-hidden="true">
    <span class="mono">{catalog}</span>
    <span class="wide">{site.label.name}</span>
  </div>
  <div class="s-bottom" aria-hidden="true">
    <span class="display s-album">{album}</span>
    <span class="wide s-artist">{site.name}</span>
  </div>
  {obi && <Obi head={catalog} title={obi.title} sub={obi.sub} foot={obi.foot} accent={spec.accent} />}
  {sticker && <span class="sticker s-sticker">{sticker}</span>}
</div>

<style>
  .sleeve {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--s-bg);
    color: var(--s-fg);
    border-radius: 2px;
    box-shadow: var(--shadow-sleeve);
    isolation: isolate;
  }

  /* A whisper of card-stock wear along the spine and edges. */
  .sleeve::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.08), transparent 2.5%, transparent 97.5%, rgb(0 0 0 / 0.12)),
      linear-gradient(180deg, rgb(255 255 255 / 0.06), transparent 3%);
    z-index: 3;
  }

  .art,
  .art :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .s-top {
    position: absolute;
    top: 5.5cqi;
    left: 6cqi;
    right: 6cqi;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    z-index: 2;
  }

  .s-top .mono {
    font-size: max(0.6rem, 3.1cqi);
  }

  .s-top .wide {
    font-size: max(0.5rem, 2.4cqi);
    opacity: 0.85;
  }

  .s-bottom {
    position: absolute;
    left: 6cqi;
    right: 6cqi;
    bottom: 6cqi;
    display: grid;
    gap: 2.4cqi;
    z-index: 2;
  }

  .s-album {
    font-size: 13.5cqi;
    line-height: 0.84;
    text-wrap: balance;
  }

  .s-artist {
    font-size: max(0.5rem, 2.6cqi);
  }

  /* Clear the obi on the left. */
  .has-obi .s-top,
  .has-obi .s-bottom {
    left: 19cqi;
  }

  .s-sticker {
    position: absolute;
    top: 13cqi;
    right: 5cqi;
    width: 25cqi;
    font-size: max(0.5rem, 2.5cqi);
    z-index: 4;
  }
</style>
