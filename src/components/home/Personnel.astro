---
/**
 * B1 · Personnel: credits as they'd read on the back of the sleeve, small and
 * tidy. Then the repertoire as Side B's tracklist, and the session strengths.
 */
import SectionHead from '@/components/SectionHead.astro';
import { site } from '@/data/site';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container">
    <SectionHead id="skills-title" track="B1" label="Skills & tools" title="Personnel" meta="& instrumentation">
      <p>Credits as they’d read on the back of the sleeve: the instrument, and the part it plays.</p>
    </SectionHead>

    <div class="credits">
      {
        site.skills.map((g) => (
          <section class="credit-group" aria-label={g.group}>
            <h3 class="wide">{g.group}</h3>
            <ul>
              {g.credits.map((c) => (
                <li>
                  <span class="c-name">{c.name}</span>
                  <span class="c-dots" aria-hidden="true" />
                  <span class="c-part serif">{c.part}</span>
                </li>
              ))}
            </ul>
            {g.note && <p class="c-note">{g.note}</p>}
          </section>
        ))
      }
    </div>

    <div class="b-side">
      <section class="tracklist" aria-labelledby="bill-title">
        <h3 id="bill-title" class="wide tl-head"><span>The repertoire</span><span class="mono">Marketing</span></h3>
        <ol>
          {
            site.repertoire.map((a, i) => (
              <li>
                <span class="mono tl-n" aria-hidden="true">
                  B{pad(i + 1)}
                </span>
                <span class="tl-name">{a}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="strengths" aria-labelledby="strengths-title">
        <h3 id="strengths-title" class="wide">Also on this record</h3>
        <ul>
          {site.strengths.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .credits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 2.25rem clamp(1.5rem, 1rem + 2vw, 3rem);
    align-items: start;
  }

  .credit-group h3 {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
  }

  .credit-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credit-group li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.42rem;
    border-bottom: 1px solid var(--line-soft);
    font-size: var(--step--1);
  }

  .c-name {
    font-weight: 600;
    white-space: nowrap;
  }

  .c-dots {
    flex: 1;
    min-width: 0.75rem;
    border-bottom: 1px dotted var(--line);
    translate: 0 -0.25em;
  }

  .c-part {
    color: var(--muted);
    font-size: 1.05em;
    text-align: right;
  }

  .c-note {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  /* ── Side B's tracklist, and the session notes ── */
  .b-side {
    display: grid;
    gap: 2.5rem clamp(2rem, 1rem + 4vw, 5rem);
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  @media (min-width: 60rem) {
    .b-side {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }

  .tl-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
    color: var(--mustard);
  }

  .tl-head .mono {
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .tracklist ol {
    columns: 2 15rem;
    column-gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tracklist li {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line-soft);
    break-inside: avoid;
  }

  .tl-n {
    flex: none;
    color: var(--mustard);
    font-size: 0.7rem;
  }

  .tl-name {
    font-size: var(--step--1);
    font-weight: 500;
  }

  .strengths {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .strengths h3 {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--ink);
    color: var(--muted);
  }

  .strengths ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .strengths .chip {
    white-space: normal;
    line-height: 1.3;
  }
</style>
