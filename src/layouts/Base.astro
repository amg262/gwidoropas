---
import { Font, getImage } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site, linkedin } from '@/data/site';
import { canonicalUrl } from '@/lib/work';
import { unlisted, UNLISTED_ROBOTS } from '@/lib/visibility';
import '@/styles/global.css';

interface Props {
  /** Page title. Omit on the home page to use the site title. */
  title?: string;
  description?: string;
  /** Path of the Open Graph image, relative to the site root. */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Keep this page out of search even once the site is public (e.g. the 404). */
  noindex?: boolean;
}

const { title, description = site.description, ogImage = '/og/home.png', ogType = 'website', jsonLd = [], noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = canonicalUrl(Astro.url, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const current = site.experience.find((e) => e.end === null && e.nowPlaying);
// A plain JPEG for crawlers and knowledge panels (they don't all read AVIF).
const portrait = site.portrait ? await getImage({ src: site.portrait.src, format: 'jpg', width: site.portrait.src.width }) : null;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.href,
  image: portrait ? new URL(portrait.src, Astro.site).href : undefined,
  email: `mailto:${site.contact.email}`,
  jobTitle: current ? current.role.split(',')[0] : site.headline,
  worksFor: current ? { '@type': 'Organization', name: current.org, url: current.url } : undefined,
  address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressRegion: site.location.region, addressCountry: 'US' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Waukesha County Technical College' },
  knowsAbout: site.skills.flatMap((g) => g.credits.map((c) => c.name)).slice(0, 14),
  sameAs: site.social.map((s) => s.href),
};

const structuredData = [personLd, ...jsonLd];
const ga4 = site.analytics.ga4;
const robots = unlisted ? UNLISTED_ROBOTS : noindex ? 'noindex' : null;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

    <!-- Start the turntable paused for reduced-motion users (or whoever paused it last). Runs before paint. -->
    <script is:inline>
      (function () {
        var m = null;
        try {
          m = localStorage.getItem('motion');
        } catch (e) {}
        if (!m) m = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'paused' : 'playing';
        document.documentElement.dataset.motion = m;
      })();
    </script>

    <meta name="theme-color" content="#efe8da" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!unlisted && <link rel="sitemap" href="/sitemap-index.xml" />}
    {linkedin && <link rel="me" href={linkedin.href} />}

    <!-- Open Graph / LinkedIn / iMessage / Slack previews -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ? `${title}, a release by ${site.name}` : `${site.name}: ${site.headline}`} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-serif" preload={[{ style: 'italic', subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-hand" />

    {structuredData.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      ga4 && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      site.advanceCopy && (
        <aside class="promo-strip" aria-label="Draft notice">
          <div class="promo-run mono">
            <span>Advance promo copy</span>
            <span aria-hidden="true">✦</span>
            <span>Not for sale</span>
            <span aria-hidden="true">✦</span>
            <span>Words pending the artist’s approval</span>
          </div>
        </aside>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {site.analytics.vercel && <Analytics />}
  </body>
</html>

<style>
  /* Quiet now: a hairline note on the paper, like the strip on a promo pressing.
     (resume.astro's print CSS hides it by this class name.) */
  .promo-strip {
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .promo-run {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.9rem;
    padding: 0.4rem var(--gutter);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  .promo-run [aria-hidden] {
    color: var(--red-ink);
  }

  :global(html:not([data-motion]) .motion-toggle) {
    display: none;
  }
</style>
