---
import Record from '@/components/Record.astro';
import Icon from '@/components/Icon.astro';
import MotionToggle from '@/components/MotionToggle.astro';
import { coverSvg, VENN } from '@/lib/cover';
import { site, catalog } from '@/data/site';

/** "*word*" → <em>word</em>, each em tagged with its Venn ink. */
const inks = ['ink-red', 'ink-cobalt', 'ink-mustard'];
let i = 0;
const tagline = site.hero.tagline.replace(/\*([^*]+)\*/g, (_, w) => `<em class="${inks[i++ % 3]}">${w}</em>`);

const venn = coverSvg({ style: 'venn', bg: '#16130f', fg: '#efe8da', accent: '#e0452b', seed: 'debut' });
const pct = (n: number) => `${((n / 600) * 100).toFixed(2)}%`;
const [m, t, d] = VENN.centres;
const [first, ...rest] = site.name.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker">
        <span class="mono">{catalog(1)}</span>
        <span class="wide">{site.label.name} presents</span>
      </p>

      <h1 id="hero-title" class="display hero-name">
        <span>{first}</span>
        <span>{rest.join(' ')}</span>
      </h1>

      <p class="hero-role wide"><span class="rule" aria-hidden="true"></span>{site.headline}</p>

      <p class="hero-tagline serif" set:html={tagline} />

      <p class="hero-intro">{site.hero.intro}</p>

      <div class="hero-actions">
        <a class="btn" href="#work"><Icon name="play" /> Selected work</a>
        <a class="btn btn-ghost" href={site.resume.href}>Résumé <Icon name="arrow-right" /></a>
      </div>
    </div>

    <div class="hero-art">
      <div class="turntable">
        <Record class="hero-record" uid="hero" ring={`${site.label.name} · Side A · 33⅓ RPM · Stereo · `} center={catalog(1)} sub="Side A" />

        <div class="hero-sleeve" role="img" aria-label={`Album cover: three overlapping circles labelled marketing, technology and design. ${site.name} works where they meet.`}>
          <div class="art" set:html={venn} />
          <div class="hs-name display" aria-hidden="true">
            <span>{first}</span><span>{rest.join(' ')}</span>
          </div>
          <span class="hs-tag mono" style={`left:${pct(m.x)};top:${pct(m.y - VENN.r - 26)}`} aria-hidden="true">Marketing</span>
          <span class="hs-tag mono" style={`left:${pct(t.x + 40)};top:${pct(t.y + VENN.r + 16)}`} aria-hidden="true">Technology</span>
          <span class="hs-tag mono" style={`left:${pct(d.x - 40)};top:${pct(d.y + VENN.r + 16)}`} aria-hidden="true">Design</span>
          <div class="hs-foot" aria-hidden="true">
            <span class="mono">{catalog(1)} · LP</span>
            <span class="wide">{site.label.name}</span>
          </div>
        </div>
      </div>

      <div class="hero-under">
        <ul class="specs mono" aria-label="Pressing details">
          <li>Stereo</li>
          <li>33⅓ RPM</li>
          <li>{site.label.city}</li>
        </ul>
        <MotionToggle />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding-block: clamp(2.5rem, 1rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 6rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }
  }

  /* ── Copy ── */
  .hero-copy {
    display: grid;
    justify-items: start;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.4rem;
  }

  .kicker .mono {
    padding: 0.25em 0.6em;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 0.74rem;
  }

  .hero-name {
    display: grid;
    font-size: clamp(5.2rem, 0.5rem + 19vw, 12rem);
    line-height: 0.8;
    letter-spacing: -0.012em;
  }

  @media (min-width: 60rem) {
    .hero-name {
      font-size: clamp(7rem, 1rem + 10.5vw, 12.5rem);
    }
  }

  .hero-name span:last-child {
    color: var(--red);
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    font-size: clamp(0.78rem, 0.7rem + 0.3vw, 0.95rem);
  }

  .hero-role .rule {
    width: 2.5rem;
    height: 2px;
    background: var(--ink);
  }

  .hero-tagline {
    max-width: 18ch;
    margin-top: 1.2rem;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.6rem);
    line-height: 1.02;
  }

  .hero-tagline :global(em) {
    font-style: italic;
    text-decoration-line: underline;
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.12em;
    text-decoration-skip-ink: none;
  }

  .hero-tagline :global(.ink-red) {
    text-decoration-color: var(--red);
  }
  .hero-tagline :global(.ink-cobalt) {
    text-decoration-color: var(--cobalt);
  }
  .hero-tagline :global(.ink-mustard) {
    text-decoration-color: var(--mustard);
  }

  .hero-intro {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: var(--step-0);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* ── Turntable ── */
  .hero-art {
    width: 100%;
    max-width: 44rem;
    justify-self: center;
  }

  .turntable {
    position: relative;
    width: 100%;
    aspect-ratio: 1.42 / 1;
  }

  .hero-sleeve {
    position: absolute;
    left: 0;
    top: 0;
    width: 70.4%;
    aspect-ratio: 1;
    container-type: inline-size;
    overflow: hidden;
    background: #16130f;
    color: #efe8da;
    border-radius: 2px;
    box-shadow: var(--shadow-sleeve);
    z-index: 2;
  }

  .hero-sleeve::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.07), transparent 2.5%, transparent 97%, rgb(0 0 0 / 0.25));
  }

  .hero-sleeve .art,
  .hero-sleeve .art :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hs-name {
    position: absolute;
    top: 6cqi;
    left: 6cqi;
    display: grid;
    font-size: 15.5cqi;
    line-height: 0.82;
  }

  .hs-tag {
    position: absolute;
    transform: translateX(-50%);
    font-size: 2.6cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.9;
  }

  .hs-foot {
    position: absolute;
    left: 6cqi;
    right: 6cqi;
    bottom: 5.5cqi;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .hs-foot .mono {
    font-size: 2.9cqi;
  }

  .hs-foot .wide {
    font-size: 2.3cqi;
    opacity: 0.8;
  }

  .turntable :global(.hero-record) {
    position: absolute;
    top: 2.2%;
    left: 2.2%;
    width: 66%;
    z-index: 1;
    transform: translateX(var(--out, 44%));
    animation: slide-out 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
    transition: transform 0.6s var(--ease);
  }

  .turntable:hover :global(.hero-record) {
    --out: 48%;
  }

  @keyframes slide-out {
    from {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turntable :global(.hero-record) {
      animation: none;
    }
  }

  .hero-under {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.74rem;
    color: var(--muted);
    text-transform: uppercase;
  }

  .specs li + li::before {
    content: '·';
    margin-right: 1.1rem;
  }
</style>
