---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import LinerNotes from '@/components/home/LinerNotes.astro';
import Crate from '@/components/home/Crate.astro';
import Releases from '@/components/home/Releases.astro';
import OnTheRecord from '@/components/home/OnTheRecord.astro';
import SideB from '@/components/home/SideB.astro';
import Personnel from '@/components/home/Personnel.astro';
import Certified from '@/components/home/Certified.astro';
import Studio from '@/components/home/Studio.astro';
import Booking from '@/components/home/Booking.astro';
import Booth from '@/components/home/Booth.astro';
import { site } from '@/data/site';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: site.title,
  description: site.description,
  url: Astro.site?.href,
  mainEntity: { '@type': 'Person', name: site.name },
};
---

<Base ogType="profile" jsonLd={[websiteLd]}>
  <Hero />
  <LinerNotes />
  <Crate />
  <Releases />
  <OnTheRecord />
  <Booth>
    <SideB />
    <Personnel />
    <Certified />
    <Studio />
  </Booth>
  <Booking />
</Base>
