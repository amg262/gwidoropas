---
/** Tiny inline icon set (stroke icons, 24px grid). Decorative by default. */
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'download' | 'mail' | 'copy' | 'check' | 'printer';
  label?: string;
}
const { name, label } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 18l-6-6 6-6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  copy: 'M9 9h10v10H9zM5 15V5h10',
  check: 'M5 12.5l4.5 4.5L19 7',
  printer: 'M7 9V4h10v5M7 17H5v-6h14v6h-2M8 14h8v6H8z',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
