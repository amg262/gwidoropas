---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Ticker from '@/components/home/Ticker.astro';
import LinerNotes from '@/components/home/LinerNotes.astro';
import Discography from '@/components/home/Discography.astro';
import Releases from '@/components/home/Releases.astro';
import SideB from '@/components/home/SideB.astro';
import Personnel from '@/components/home/Personnel.astro';
import Certified from '@/components/home/Certified.astro';
import Studio from '@/components/home/Studio.astro';
import Booking from '@/components/home/Booking.astro';
import { site } from '@/data/site';

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: site.title,
  description: site.description,
  url: Astro.site?.href,
  mainEntity: { '@type': 'Person', name: site.name },
};
---

<Base ogType="profile" jsonLd={[websiteLd]}>
  <Hero />
  <Ticker />
  <LinerNotes />
  <Discography />
  <Releases />
  <SideB />
  <Personnel />
  <Certified />
  <Studio />
  <Booking />
</Base>
