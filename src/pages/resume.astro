---
/**
 * The printable résumé: the one-page "send version", pressed from
 * src/data/site.ts so the site and the résumé can never drift apart.
 * On screen it's a lyric-sheet insert; in print it's plain black on white.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site, linkedin } from '@/data/site';
import { formatRange, formatPressing } from '@/lib/dates';

const host = Astro.site && !Astro.site.host.startsWith('localhost') ? Astro.site.host : null;
const marketing = site.experience.filter((e) => e.format !== 'Box set');
const operations = site.experience.filter((e) => e.format === 'Box set');
const linkedinText = linkedin?.href.replace(/^https?:\/\/(www\.)?/, '');
---

<Base title="Résumé" description={`Résumé of ${site.name}, ${site.headline.toLowerCase()}: experience, skills and education.`}>
  <div class="container toolbar">
    <a class="link-arrow" href="/"><Icon name="arrow-left" /> Back to the record</a>
    <p class="mono pressed">Pressed {formatPressing()} from the master tape</p>
    <button class="btn" type="button" data-print><Icon name="printer" /> Print / Save as PDF</button>
  </div>

  <article class="container sheet" aria-label={`Résumé of ${site.name}`}>
    <header class="r-head">
      <h1 class="r-name">{site.name}</h1>
      <p class="r-contact">
        <span>{site.location.city}, {site.location.region}</span>
        {site.contact.phone && <span>{site.contact.phone}</span>}
        <span><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></span>
        {linkedin && <span><a href={linkedin.href}>{linkedinText}</a></span>}
        {host && <span><a href="/">{host}</a></span>}
      </p>
    </header>

    <section>
      <h2>Summary</h2>
      <p>{site.resumeSummary}</p>
    </section>

    <section>
      <h2>Skills &amp; tools</h2>
      <ul class="r-skills">
        {
          site.resumeSkills.map((s) => (
            <li>
              <strong>{s.group}:</strong> {s.items}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Marketing experience</h2>
      {
        marketing.map((job) => (
          <div class="r-item">
            <div class="r-row">
              <h3>
                {job.org}
                {job.orgNote && <span class="r-note">, {job.orgNote.toLowerCase()}</span>}
                <span class="r-note">, {job.location}</span>
              </h3>
              <p class="r-date">{formatRange(job.start, job.end)}</p>
            </div>
            <p class="r-role">{job.role}</p>
            <ul>
              {(job.resumeBullets ?? job.bullets).map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    {
      operations.map((job) => (
        <section>
          <h2>Operations experience</h2>
          <div class="r-item">
            <div class="r-row">
              <h3>
                {job.org}
                <span class="r-note">, {job.location}</span>
              </h3>
              <p class="r-date">{formatRange(job.start, job.end)}</p>
            </div>
            <p class="r-role">{job.discs?.map((d) => `${d.role} (${formatRange(d.start, d.end)})`).join('  |  ')}</p>
            <ul>
              {(job.resumeBullets ?? job.bullets).map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <section>
      <h2>Education</h2>
      {
        site.education.schools.map((s) => (
          <div class="r-item">
            <div class="r-row">
              <h3>
                {s.school}
                {s.place && <span class="r-note">, {s.place}</span>}
              </h3>
              <p class="r-date">{s.when}</p>
            </div>
            <p class="r-plain">{s.detail}</p>
          </div>
        ))
      }
      <p class="r-plain r-projects"><strong>Projects:</strong> {site.resumeProjects.join('  |  ')}</p>
    </section>

    <section>
      <h2>Earlier experience</h2>
      <p class="r-plain">{site.earlier.map((e) => `${e.role.replace(/ \(.*\)/, '')}, ${e.org.replace(', Wisconsin State Fair', ' at the Wisconsin State Fair')}${e.when !== 'Seasonal' ? ` (${e.when.replace(' – ', '–')})` : ''}`).join('  |  ')}</p>
    </section>
  </article>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 1.5rem;
  }

  .pressed {
    font-size: 0.74rem;
    color: var(--muted);
  }

  .sheet {
    max-width: 54rem;
    margin-bottom: clamp(3rem, 2rem + 4vw, 6rem);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    background: var(--card);
    color: var(--ink);
    border-radius: 2px;
    box-shadow: var(--shadow-sleeve);
    font-size: 0.95rem;
    line-height: 1.5;
    border-top: 10px solid var(--red);
  }

  .r-head {
    display: grid;
    gap: 0.6rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
  }

  .r-name {
    font-stretch: 62%;
    font-weight: 800;
    font-size: clamp(2.6rem, 1.8rem + 3vw, 4rem);
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .r-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    color: var(--ink-2);
    font-size: 0.9em;
  }

  .r-contact span + span::before {
    content: '|';
    margin-inline: 0.6em;
    color: var(--line);
  }

  .r-contact a {
    text-decoration: none;
  }

  section {
    padding-top: 1.2em;
  }

  h2 {
    margin-bottom: 0.55em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--line);
    font-stretch: 125%;
    font-size: 0.72em;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red-ink);
  }

  .r-item + .r-item {
    margin-top: 0.85em;
  }

  .r-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
  }

  h3 {
    font-size: 1.02em;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .r-note {
    font-weight: 400;
    color: var(--ink-2);
  }

  .r-date {
    color: var(--ink-2);
    font-size: 0.92em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .r-role {
    font-style: italic;
    color: var(--ink-2);
  }

  .r-item ul,
  .r-skills {
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
  }

  .r-skills strong,
  .r-projects strong {
    color: var(--ink);
  }

  .r-plain {
    color: var(--ink-2);
  }

  .r-projects {
    margin-top: 0.6em;
  }

  @media print {
    @page {
      size: letter;
      margin: 0.45in 0.55in;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    :global(.promo-strip),
    .toolbar {
      display: none !important;
    }

    :global(body::after) {
      display: none !important;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
    }

    .sheet {
      max-width: none;
      width: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      background: #fff;
      font-size: 8.9pt;
      line-height: 1.36;
      --ink: #000;
      --ink-2: #1f1f1f;
      --line: #999;
      --red-ink: #000;
      color: #000;
    }

    .r-name {
      font-size: 26pt;
    }

    section {
      padding-top: 0.75em;
    }

    .r-item + .r-item {
      margin-top: 0.55em;
    }

    section,
    .r-item {
      break-inside: avoid;
    }

    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
