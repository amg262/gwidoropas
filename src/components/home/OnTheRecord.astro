---
/**
 * A4 · Staff pick: recommendations, written up the way a record shop pins a
 * hand-lettered card beside a record it loves. Quoted word for word from
 * LinkedIn (see site.recommendations): the opening paragraph on the card, the
 * rest a click away.
 */
import SectionHead from '@/components/SectionHead.astro';
import Icon from '@/components/Icon.astro';
import { recommendations, monogram } from '@/lib/recommendations';
import { formatYm } from '@/lib/dates';

const n = recommendations.length;
---

{
  n > 0 && (
    <section id="recommendations" class="section on-record" aria-labelledby="recommendations-title">
      <div class="container">
        <SectionHead id="recommendations-title" track="A4" label="Recommendations" title="On the record" meta={n === 1 ? '1 review' : `${n} reviews`}>
          <p>In their words, not mine.</p>
        </SectionHead>

        <div class="picks">
          {recommendations.map((r) => {
            const [lede, ...body] = r.paragraphs;
            return (
              <figure class="pick">
                <span class="pin" aria-hidden="true" />
                <p class="pk-head">
                  <span class="hand pk-k">Staff pick</span>
                  <span class="mono pk-date">
                    {r.url && 'LinkedIn · '}
                    {formatYm(r.date)}
                  </span>
                </p>

                <blockquote class="pk-quote">
                  <p class="hand pk-lede">
                    <span aria-hidden="true">“</span>
                    {lede}
                    {body.length === 0 && <span aria-hidden="true">”</span>}
                  </p>
                  {body.length > 0 && (
                    <details class="pk-more">
                      <summary class="link-arrow">
                        <span class="pk-open">Read the full recommendation</span>
                        <span class="pk-close">Fold it back up</span>
                        <Icon name="arrow-down" />
                      </summary>
                      <div class="pk-body">
                        {body.map((p) => (
                          <p>{p}</p>
                        ))}
                      </div>
                    </details>
                  )}
                </blockquote>

                <figcaption class="pk-by">
                  <span class="pk-mark" style={`--mark-bg:${r.mark.bg};--mark-fg:${r.mark.fg}`} aria-hidden="true">
                    <span class="display">{monogram(r.name)}</span>
                  </span>
                  <span class="pk-who">
                    <span class="display pk-name">{r.name}</span>
                    <span class="pk-role">{r.role}</span>
                    {r.about && <span class="pk-about">{r.about}</span>}
                    <span class="pk-rel">{r.relationship}</span>
                  </span>
                  {r.url && (
                    <a class="btn btn-ghost pk-link" href={r.url} target="_blank" rel="noopener">
                      <Icon name="linkedin" /> Read it on LinkedIn
                    </a>
                  )}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .picks {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    justify-items: center;
  }

  /* An index card pinned to the wall: ruled, a red head line, a little askew.
     A physical object, so it keeps its colours in the dark scheme too. */
  .pick {
    --rule: 2.1rem;
    position: relative;
    width: min(100%, 50rem);
    padding: clamp(1.6rem, 1rem + 2vw, 2.6rem) clamp(1.25rem, 0.5rem + 3vw, 3rem) clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    background:
      linear-gradient(transparent calc(var(--top, 4.6rem) - 1px), rgb(224 69 43 / 0.55) calc(var(--top, 4.6rem) - 1px) var(--top, 4.6rem), transparent var(--top, 4.6rem)),
      repeating-linear-gradient(transparent 0 calc(var(--rule) - 1px), rgb(42 71 192 / 0.13) calc(var(--rule) - 1px) var(--rule)) 0 calc(var(--top, 4.6rem) + 0.15rem) / 100% 100% no-repeat,
      #f7f2e8;
    color: #16130f;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 24px 40px -24px rgb(30 20 10 / 0.55),
      0 4px 10px -6px rgb(30 20 10 / 0.3);
    rotate: -0.8deg;
    --ink: #16130f;
    --ink-2: #3a352e;
    --muted: #625b4f;
    --line: #cfc4ae;
    --red-ink: #b3321c;
  }

  .pin {
    position: absolute;
    top: 0.7rem;
    left: 50%;
    width: 0.95rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff8166, #e0452b 45%, #9c2a17);
    box-shadow: 0 3px 4px rgb(0 0 0 / 0.35);
    translate: -50% 0;
  }

  .pk-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: calc(var(--top, 4.6rem) - clamp(1.6rem, 1rem + 2vw, 2.6rem) - 0.4rem);
  }

  .pk-k {
    color: #b3321c;
    font-size: clamp(1.9rem, 1.6rem + 1vw, 2.4rem);
    rotate: -2deg;
  }

  .pk-date {
    color: var(--muted);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .pk-quote {
    margin-top: 0.4rem;
  }

  /* Written on the ruled lines. */
  .pk-lede {
    font-size: clamp(1.45rem, 1.2rem + 0.9vw, 1.85rem);
    line-height: var(--rule);
    color: #16130f;
    text-wrap: pretty;
  }

  .pk-more {
    margin-top: 1rem;
  }

  .pk-more summary {
    display: inline-flex;
    width: fit-content;
    text-wrap: balance;
    cursor: pointer;
    color: #b3321c;
    list-style: none;
  }

  .pk-more summary::-webkit-details-marker {
    display: none;
  }

  .pk-more summary :global(svg) {
    transition: rotate 0.25s var(--ease);
  }

  .pk-more[open] summary :global(svg) {
    rotate: 180deg;
  }

  .pk-close,
  .pk-more[open] .pk-open {
    display: none;
  }

  .pk-more[open] .pk-close {
    display: inline;
  }

  .pk-body {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgb(255 255 255 / 0.6);
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .pk-by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.1rem;
    margin-top: 1.6rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .pk-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--mark-bg) 0 54%, #0e0d0b 55%);
    color: var(--mark-fg);
    box-shadow: 0 4px 8px -4px rgb(0 0 0 / 0.5);
  }

  .pk-mark .display {
    font-size: 0.8rem;
  }

  .pk-who {
    display: grid;
    gap: 0.1rem;
    flex: 1 1 18rem;
  }

  .pk-name {
    font-size: 1.35rem;
  }

  .pk-role {
    font-weight: 600;
    font-size: 0.92rem;
  }

  .pk-about,
  .pk-rel {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .pk-link {
    --btn-fg: #16130f;
    --btn-bd: #16130f;
  }

  @media (prefers-reduced-motion: reduce) {
    .pk-more summary :global(svg) {
      transition: none;
    }
  }
</style>
