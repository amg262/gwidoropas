---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
---

<Base title="Page not found" noindex>
  <section class="container nf">
    <p class="code" aria-hidden="true">404</p>
    <h1>This page didn’t make the final cut.</h1>
    <p>The link may be old, or the page may have moved.</p>
    <div class="actions">
      <a class="btn" href="/">Go home <Icon name="arrow-right" /></a>
      <a class="btn btn--ghost" href="/#work">See the work</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(4rem, 3rem + 8vw, 10rem);
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-style: italic;
    font-weight: 300;
    line-height: 0.9;
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-4);
    font-weight: 400;
    max-width: 18ch;
  }

  p {
    color: var(--ink-2);
    font-size: var(--step-1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
