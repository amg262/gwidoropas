---
import Sleeve from './Sleeve.astro';
import Record from './Record.astro';
import type { Work } from '@/lib/work';
import { uid } from '@/lib/uid';
import { site } from '@/data/site';

interface Props {
  entry: Work;
  headingLevel?: 'h3' | 'h2';
}

const { entry, headingLevel: H = 'h3' } = Astro.props;
const d = entry.data;
const lead = d.metrics[0]!;
/** The headline metric, hand-lettered on the shelf tag like a price. Pending numbers read TBA. */
const price = lead.pending ? 'TBA' : lead.value;
---

<article class="card">
  <a class="card-link" href={`/work/${entry.id}`}>
    <div class="card-art">
      <Record class="card-record" uid={uid('cr')} ring={`${site.label.name} · ${d.album} · `} center={d.catalog} labelBg={d.cover.accent} labelFg={d.cover.bg} />
      <Sleeve
        class="card-sleeve"
        spec={{ ...d.cover, seed: entry.id }}
        album={d.album}
        catalog={d.catalog}
        sticker={d.status === 'recording' ? 'Now recording' : undefined}
        image={d.coverImage}
        imageAlt={d.coverAlt}
      />
    </div>
    <span class="card-ledge" aria-hidden="true"></span>

    <p class:list={['tag', { pending: lead.pending }]}>
      <span class="hand tag-v">{price}</span>
      <span class="mono tag-l">{lead.label}</span>
    </p>

    <div class="card-meta">
      <p class="mono card-cat">
        {d.catalog} · {d.context}{d.released && ` · ${d.released}`}
      </p>
      <H class="card-title">{d.title}</H>
      <p class="card-summary">{d.summary}</p>
      <span class="link-arrow card-cta">Play the release <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .card-link {
    display: grid;
    text-decoration: none;
    color: inherit;
  }

  .card-link:hover {
    color: inherit;
  }

  /* Face-out on the wall, each leaning its own way against it. */
  .card-art {
    position: relative;
    width: 80%;
    rotate: var(--lean, -1deg);
    transform-origin: 30% 100%;
    transition: rotate 0.5s var(--ease);
  }

  :global(.wall > :nth-child(3n + 2)) .card-art {
    --lean: 0.8deg;
  }

  :global(.wall > :nth-child(3n)) .card-art {
    --lean: -0.4deg;
  }

  .card-link:hover .card-art,
  .card-link:focus-visible .card-art {
    rotate: 0deg;
  }

  .card-art :global(.card-sleeve) {
    position: relative;
    z-index: 2;
  }

  .card-art :global(.card-record) {
    position: absolute;
    top: 3%;
    left: 3%;
    width: 94%;
    z-index: 1;
    transform: translateX(14%);
    transition: transform 0.6s var(--ease);
  }

  .card-art :global(.card-record .disc) {
    animation: spin var(--spin) linear infinite;
    animation-play-state: paused;
  }

  .card-link:hover :global(.card-record),
  .card-link:focus-visible :global(.card-record) {
    transform: translateX(24%);
  }

  .card-link:hover :global(.card-record .disc),
  .card-link:focus-visible :global(.card-record .disc) {
    animation-play-state: running;
  }

  /* The ledge: runs on through the gaps, so the row reads as one shelf. */
  .card-ledge {
    position: relative;
    z-index: 3;
    height: 6px;
    margin-inline: calc(var(--gap, 0px) / -2);
    border-radius: 1px;
    background: var(--ledge);
    box-shadow: 0 10px 16px -10px rgb(0 0 0 / 0.45);
  }

  @media (max-width: 40rem) {
    .card-ledge {
      margin-inline: 0;
    }
  }

  /* A hand-lettered shelf tag, clipped under the ledge. */
  .tag {
    position: relative;
    display: grid;
    gap: 0.15rem;
    width: fit-content;
    max-width: 15rem;
    margin: -1px 0 0 1.25rem;
    padding: 0.7rem 0.9rem 0.65rem;
    background: #f7f2e8;
    color: #16130f;
    box-shadow:
      0 0 0 1px rgb(22 19 15 / 0.08),
      0 8px 14px -10px rgb(0 0 0 / 0.5);
    rotate: -2.5deg;
    transform-origin: 20% 0;
    transition: rotate 0.5s var(--ease);
  }

  /* The clip it hangs from. */
  .tag::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 1.1rem;
    width: 1.4rem;
    height: 0.45rem;
    border-radius: 1px;
    background: #8f877a;
  }

  .card-link:hover .tag {
    rotate: 1deg;
  }

  .tag-v {
    color: #b3321c;
    font-size: 2.15rem;
  }

  .tag.pending .tag-v {
    color: #625b4f;
  }

  .tag-l {
    color: #3a352e;
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .card-meta {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    margin-top: 1.4rem;
  }

  .card-cat {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .card-title {
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .card-link:hover .card-title {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.15em;
  }

  .card-summary {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .card-cta {
    margin-top: 0.3rem;
    color: var(--red-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-art,
    .tag {
      transition: none;
    }
  }
</style>
