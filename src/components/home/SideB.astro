---
import Record from '@/components/Record.astro';
import { site, catalog } from '@/data/site';
---

<section class="sideb band" aria-label="Side B">
  <div class="container sb-inner">
    <p class="display sb-title" aria-hidden="true">Side <span>B</span></p>
    <p class="serif sb-note">Flip it over: the instruments, the training, what’s in the studio right now, and how to book a session.</p>
  </div>
  <Record class="sb-record" uid="sideb" ring={`${site.label.name} · Side B · 33⅓ RPM · Stereo · `} center={catalog(1)} sub="Side B" labelBg="#e9b13b" />
</section>

<style>
  .sideb {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
  }

  .sb-inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.5rem;
  }

  .sb-title {
    font-size: clamp(6rem, 2rem + 18vw, 17rem);
    line-height: 0.78;
  }

  .sb-title span {
    color: var(--mustard);
  }

  .sb-note {
    max-width: 24ch;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    line-height: 1.1;
    color: var(--band-muted);
  }

  .sideb :global(.sb-record) {
    position: absolute;
    top: 50%;
    right: -18%;
    width: min(62vw, 46rem);
    translate: 0 -50%;
    z-index: 1;
    opacity: 0.95;
  }

  @media (max-width: 40rem) {
    .sideb :global(.sb-record) {
      right: -45%;
      width: 95vw;
      opacity: 0.55;
    }
  }
</style>
