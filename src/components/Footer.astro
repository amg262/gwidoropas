---
import { site } from '@/data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container foot">
    <p>© {year} {site.name}</p>
    <ul class="foot-links">
      <li><a href={`mailto:${site.contact.email}`}>Email</a></li>
      {
        site.social.map((s) => (
          <li>
            <a href={s.href} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="top" href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
