---
/**
 * Generated cover art for a case study: the project's accent colour, a
 * data-flavoured pattern (picked deterministically from the slug) and the
 * headline metric. If the case study sets a `cover` image, that is used instead.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  seed: string;
  accent: string;
  metric: { value: string; label: string };
  cover?: ImageMetadata;
  coverAlt?: string;
  size?: 'card' | 'hero';
  /** Set on the first above-the-fold image only. */
  eager?: boolean;
}

const { seed, accent, metric, cover, coverAlt = '', size = 'card', eager = false } = Astro.props;

const hash = [...seed].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const patterns = ['bars', 'rings', 'dots', 'arcs'] as const;
const pattern = patterns[hash % patterns.length];

const bars = [0.28, 0.4, 0.34, 0.52, 0.6, 0.74, 0.92];
const dots = Array.from({ length: 14 * 8 }, (_, i) => ({
  x: (i % 14) * 30 + 15,
  y: Math.floor(i / 14) * 30 + 15,
  big: (i * 7 + hash) % 11 === 0,
})).filter((d) => size === 'hero' || !(d.x < 230 && d.y > 110)); // keep the metric legible
---

<div class:list={['cover', `cover--${size}`]} style={`--c: ${accent}`}>
  {
    cover ? (
      <Image
        src={cover}
        alt={coverAlt}
        widths={size === 'hero' ? [800, 1200, 1600] : [480, 720, 960]}
        sizes={size === 'hero' ? '(min-width: 72rem) 72rem, 100vw' : '(min-width: 56rem) 34rem, 100vw'}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <>
        <svg class="pattern" viewBox="0 0 420 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          {pattern === 'bars' && (
            <g fill="#fff">
              {bars.map((h, i) => (
                <rect x={190 + i * 30} y={240 - h * 230} width="18" height={h * 230 + 10} rx="9" opacity={0.1 + i * 0.035} />
              ))}
              <polyline
                points={bars.map((h, i) => `${199 + i * 30},${240 - h * 230 - 18}`).join(' ')}
                fill="none"
                stroke="#fff"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                opacity="0.55"
              />
            </g>
          )}
          {pattern === 'rings' && (
            <g fill="none" stroke="#fff" stroke-width="1.5">
              {[30, 60, 90, 120, 150, 180, 210].map((r, i) => (
                <circle cx="350" cy="40" r={r} opacity={0.42 - i * 0.05} />
              ))}
              <circle cx="350" cy="40" r="12" fill="#fff" opacity="0.5" stroke="none" />
            </g>
          )}
          {pattern === 'dots' && (
            <g fill="#fff">
              {dots.map((d) => (
                <circle cx={d.x} cy={d.y} r={d.big ? 7 : 2} opacity={d.big ? 0.55 : 0.22} />
              ))}
            </g>
          )}
          {pattern === 'arcs' && (
            <g fill="none" stroke="#fff" stroke-linecap="round">
              <path d="M300 240 A120 120 0 0 1 420 120" stroke-width="26" opacity="0.18" />
              <path d="M240 240 A180 180 0 0 1 420 60" stroke-width="26" opacity="0.13" />
              <path d="M180 240 A240 240 0 0 1 420 0" stroke-width="26" opacity="0.09" />
              <path d="M300 240 A120 120 0 0 1 335 155" stroke-width="26" opacity="0.5" />
            </g>
          )}
        </svg>
        {size === 'card' && (
          <div class="metric" aria-hidden="true">
            <span class="value">{metric.value}</span>
            <span class="label">{metric.label}</span>
          </div>
        )}
      </>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--c) 92%, white) 0%, transparent 60%),
      linear-gradient(160deg, var(--c) 0%, color-mix(in oklab, var(--c) 62%, black) 100%);
    color: #fff;
    isolation: isolate;
  }

  .cover--hero {
    aspect-ratio: 5 / 2;
    border-radius: var(--radius-lg);
  }

  @media (min-width: 52rem) {
    .cover--hero {
      aspect-ratio: 4 / 1;
    }
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    transition: transform 0.8s var(--ease);
    transform-origin: 80% 20%;
  }

  .metric {
    position: absolute;
    left: clamp(1rem, 4%, 1.75rem);
    bottom: clamp(0.85rem, 4%, 1.5rem);
    right: 1rem;
    display: grid;
    gap: 0.25rem;
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2rem + 3vw, 4.25rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .label {
    max-width: 22ch;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    opacity: 0.95;
  }
</style>
