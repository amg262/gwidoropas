---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { entry, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const { title, summary, context, tags, metrics, accent, cover, coverAlt } = entry.data;
const href = `/work/${entry.id}`;
---

<article class="card">
  <Cover seed={entry.id} accent={accent} metric={metrics[0]} cover={cover} coverAlt={coverAlt} eager={eager} />
  <div class="body">
    <p class="context">{context}</p>
    <Heading class="title">
      <a href={href}>{title}</a>
    </Heading>
    <p class="summary">{summary}</p>
    <ul class="tag-list" aria-label="Disciplines">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>
    <span class="more" aria-hidden="true">Read case study <Icon name="arrow-right" /></span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .body {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .context {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .title {
    font-size: var(--step-2);
    line-height: 1.12;
  }

  .title a {
    text-decoration: none;
  }

  /* Stretched link: the whole card is clickable, but there's only one link for screen readers. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .summary {
    color: var(--ink-2);
  }

  .tag-list {
    margin-top: 0.25rem;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .more :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform 0.25s var(--ease);
  }

  .card:hover .more :global(svg) {
    transform: translateX(4px);
  }

  .card:hover .title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .card :global(.cover) {
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .card:hover :global(.cover) {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .card:hover :global(.pattern) {
    transform: scale(1.06);
  }
</style>
