---
/** Tiny inline icon set (stroke icons, 24px grid). Decorative unless given a label. */
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'arrow-down' | 'mail' | 'copy' | 'check' | 'printer' | 'play' | 'pause' | 'linkedin';
  label?: string;
}
const { name, label } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 18l-6-6 6-6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  'arrow-down': 'M12 5v14M6 13l6 6 6-6',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  copy: 'M9 9h10v10H9zM5 15V5h10',
  check: 'M5 12.5l4.5 4.5L19 7',
  printer: 'M7 9V4h10v5M7 17H5v-6h14v6h-2M8 14h8v6H8z',
  play: 'M8 5.5v13l10.5-6.5z',
  pause: 'M8 5v14M16 5v14',
  linkedin: 'M5 9.5v9M5 5.5v.01M10 18.5v-9M10 13.5c0-2.2 1.4-4 3.5-4s3.5 1.3 3.5 4v5',
};
const filled = name === 'play';
---

<svg
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={name === 'pause' ? 2.6 : 1.8}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
