---
/**
 * A1 · Liner notes: the back of the sleeve. A print of the artist taped up
 * beside the pull quote, the notes in narrow liner columns, and the three
 * things to know, each with the number that backs it.
 */
import { Picture } from 'astro:assets';
import SectionHead from '@/components/SectionHead.astro';
import { site, PLANT_START, catalog } from '@/data/site';
import { yearsSince } from '@/lib/dates';

/* One number per hook, in hook order: the plant floor, AI software, live events. */
const backing = [
  { value: `${yearsSince(PLANT_START)}+`, label: 'Years inside a B2B manufacturer' },
  { value: '2', label: 'AI products I market at Amarna' },
  { value: '3', label: 'Private events for Peyton Pours' },
];
---

<section id="about" class="section liner" aria-labelledby="about-title">
  <div class="container">
    <SectionHead id="about-title" track="A1" label="About" title="Liner notes" meta="Side A" />

    <div class:list={['back', { 'has-portrait': site.portrait }]}>
      {
        site.portrait && (
          <figure class="portrait">
            <div class="print">
              <span class="tape tape-l" aria-hidden="true" />
              <span class="tape tape-r" aria-hidden="true" />
              <Picture
                src={site.portrait.src}
                alt={site.portrait.alt}
                formats={['avif', 'webp']}
                widths={[240, 360, site.portrait.src.width]}
                sizes="(min-width: 36rem) 16rem, 70vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="portrait-cap mono">
              <span>The artist</span>
              <span>{catalog(1)} · Back cover</span>
            </figcaption>
          </figure>
        )
      }

      <div class="words">
        <figure class="pull">
          <blockquote class="serif">
            <span class="pull-mark" aria-hidden="true">“</span>{site.about.pullQuote}
          </blockquote>
          <figcaption class="wide">{site.name}</figcaption>
        </figure>

        <div class="liner-text">
          {site.about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <ol class="hooks" aria-label="Three things to know">
      {
        site.about.hooks.map((h, i) => (
          <li>
            {backing[i] && (
              <p class="hk-stat">
                <span class="display hk-n">{backing[i].value}</span>
                <span class="mono hk-l">{backing[i].label}</span>
              </p>
            )}
            <h3 class="wide hk-t">{h.title}</h3>
            <p class="hk-b">{h.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .back {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  @media (min-width: 52rem) {
    .back.has-portrait {
      grid-template-columns: 16rem minmax(0, 1fr);
      column-gap: clamp(3rem, 1rem + 5vw, 7rem);
      align-items: start;
    }
  }

  /* ── A print, taped to the back cover ── */
  .portrait {
    width: min(78%, 16rem);
    justify-self: center;
    rotate: -2.2deg;
  }

  @media (min-width: 52rem) {
    .portrait {
      width: 100%;
      margin-top: 0.75rem;
    }
  }

  .print {
    position: relative;
    padding: 0.6rem 0.6rem 0;
    background: #f7f2e8;
    box-shadow: var(--shadow-sleeve);
  }

  .print :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .print::after {
    content: '';
    display: block;
    height: 2.2rem;
  }

  .tape {
    position: absolute;
    z-index: 2;
    top: -0.7rem;
    width: 4.4rem;
    height: 1.5rem;
    background: rgb(232 220 196 / 0.78);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
    -webkit-mask: linear-gradient(90deg, transparent 0 2px, #000 2px calc(100% - 2px), transparent calc(100% - 2px));
    mask: linear-gradient(90deg, transparent 0 2px, #000 2px calc(100% - 2px), transparent calc(100% - 2px));
  }

  .tape-l {
    left: -1.1rem;
    rotate: -32deg;
  }

  .tape-r {
    right: -1.1rem;
    rotate: 28deg;
  }

  .portrait-cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    margin-top: -1.75rem;
    padding: 0 0.85rem 0.6rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #625b4f;
  }

  /* ── The words ── */
  .words {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .pull blockquote {
    position: relative;
    max-width: 30ch;
    font-size: clamp(1.7rem, 1.15rem + 2vw, 2.65rem);
    line-height: 1.1;
  }

  .pull-mark {
    position: absolute;
    left: -0.55em;
    top: -0.05em;
    color: var(--red);
  }

  @media (max-width: 40rem) {
    .pull-mark {
      position: static;
    }
  }

  .pull figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }

  .pull figcaption::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  /* Set like the back of an LP: narrow columns, small type. */
  .liner-text {
    columns: 2 16rem;
    column-gap: 2.5rem;
    column-rule: 1px solid var(--line-soft);
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .liner-text p {
    break-inside: avoid;
  }

  .liner-text p + p {
    margin-top: 0.9em;
  }

  .liner-text p:first-child::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--font-serif), serif;
    font-size: 3.3em;
    line-height: 0.8;
    color: var(--ink);
  }

  /* ── Three things to know ── */
  .hooks {
    display: grid;
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 48rem) {
    .hooks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .hooks li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.4rem 0 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .hooks li {
      padding: 1.5rem clamp(1rem, 0.5rem + 1.5vw, 2rem) 0;
      border-bottom: 0;
    }

    .hooks li:first-child {
      padding-left: 0;
    }

    .hooks li + li {
      border-left: 1px solid var(--line);
    }
  }

  .hk-stat {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .hk-n {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
  }

  .hk-l {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.3;
  }

  .hk-t {
    margin-top: 0.35rem;
    color: var(--red-ink);
  }

  .hk-b {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }
</style>
