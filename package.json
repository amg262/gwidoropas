{
  "name": "gwidoropas",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "smoke": "node scripts/smoke.mjs",
    "docker:build": "docker build -t gwidoropas:local .",
    "docker:run": "docker run --rm -p 8080:8080 --read-only --tmpfs /tmp --cap-drop=ALL --security-opt no-new-privileges gwidoropas:local",
    "version:next": "node scripts/next-version.mjs",
    "readme:portrait": "node scripts/readme-portrait.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.11",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "description": "Portfolio website for a marketing student — Astro, deployed on Vercel."
